{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doomsday.radio/schemas/worldbundle.schema.json",
  "title": "Doomsday World Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "generated_at",
    "world",
    "source_inputs",
    "documents",
    "sections",
    "links",
    "media_assets",
    "media_usages",
    "entities",
    "entity_aliases",
    "entity_sources",
    "entity_relations",
    "entity_prompts",
    "entity_media",
    "media_generations",
    "validation_issues"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "bundle_id": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "world": { "$ref": "#/$defs/world" },
    "source_inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/source_input" }
    },
    "import_hints": { "$ref": "#/$defs/json_object" },
    "documents": {
      "type": "array",
      "items": { "$ref": "#/$defs/document" }
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "links": {
      "type": "array",
      "items": { "$ref": "#/$defs/link" }
    },
    "media_assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/media_asset" }
    },
    "media_usages": {
      "type": "array",
      "items": { "$ref": "#/$defs/media_usage" }
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "entity_aliases": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity_alias" }
    },
    "entity_sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity_source" }
    },
    "entity_relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity_relation" }
    },
    "entity_prompts": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity_prompt" }
    },
    "entity_media": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity_media" }
    },
    "media_generations": {
      "type": "array",
      "items": { "$ref": "#/$defs/media_generation" }
    },
    "validation_issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation_issue" }
    }
  },
  "$defs": {
    "json_object": {
      "type": "object",
      "additionalProperties": true
    },
    "world": {
      "type": "object",
      "required": ["world_id", "world_key", "name"],
      "properties": {
        "world_id": { "type": "string" },
        "world_key": { "type": "string" },
        "name": { "type": "string" },
        "primary_language": { "type": "string" },
        "source_story_root": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "metadata": { "$ref": "#/$defs/json_object" }
      },
      "additionalProperties": false
    },
    "source_input": {
      "type": "object",
      "required": ["source_name", "path"],
      "properties": {
        "source_name": { "type": "string" },
        "path": { "type": "string" },
        "sha256": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"], "format": "date-time" },
        "metadata": { "$ref": "#/$defs/json_object" }
      },
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "required": ["document_id", "path", "file_name", "stem", "raw_markdown", "sha256"],
      "properties": {
        "document_id": { "type": "string" },
        "path": { "type": "string" },
        "file_name": { "type": "string" },
        "stem": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "document_kind": { "type": ["string", "null"] },
        "path_parts": { "type": "array", "items": { "type": "string" } },
        "directory": { "type": ["string", "null"] },
        "story_file": { "type": ["string", "null"] },
        "sha256": { "type": "string" },
        "byte_length": { "type": "integer", "minimum": 0 },
        "line_count": { "type": "integer", "minimum": 0 },
        "primary_media_asset_id": { "type": ["string", "null"] },
        "raw_markdown": { "type": "string" },
        "metadata": { "$ref": "#/$defs/json_object" }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["section_id", "document_id", "ordinal", "markdown"],
      "properties": {
        "section_id": { "type": "string" },
        "document_id": { "type": "string" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "heading": { "type": ["string", "null"] },
        "level": { "type": ["integer", "null"], "minimum": 1, "maximum": 6 },
        "anchor_slug": { "type": ["string", "null"] },
        "start_line": { "type": ["integer", "null"], "minimum": 1 },
        "end_line": { "type": ["integer", "null"], "minimum": 1 },
        "markdown": { "type": "string" },
        "plaintext": { "type": ["string", "null"] },
        "metadata": { "$ref": "#/$defs/json_object" }
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": ["link_id", "document_id", "link_kind", "raw_target"],
      "properties": {
        "link_id": { "type": "string" },
        "document_id": { "type": "string" },
        "section_id": { "type": ["string", "null"] },
        "line_number": { "type": ["integer", "null"], "minimum": 1 },
        "link_kind": {
          "type": "string",
          "enum": ["document", "image", "asset", "external", "anchor", "unknown"]
        },
        "label": { "type": ["string", "null"] },
        "alt_text": { "type": ["string", "null"] },
        "raw_target": { "type": "string" },
        "target_document_id": { "type": ["string", "null"] },
        "target_media_id": { "type": ["string", "null"] },
        "target_url": { "type": ["string", "null"] },
        "target_fragment": { "type": ["string", "null"] },
        "resolved_path": { "type": ["string", "null"] },
        "resolved_kind": { "type": ["string", "null"] },
        "metadata": { "$ref": "#/$defs/json_object" }
      },
      "additionalProperties": false
    },
    "media_asset": {
      "type": "object",
      "required": ["media_id", "path", "media_kind"],
      "properties": {
        "media_id": { "type": "string" },
        "path": { "type": "string" },
        "story_file": { "type": ["string", "null"] },
        "file_name": { "type": "string" },
        "extension": { "type": ["string", "null"] },
        "mime_type": { "type": ["string", "null"] },
        "media_kind": { "type": "string", "enum": ["image", "asset"] },
        "sha256": { "type": ["string", "null"] },
        "byte_length": { "type": ["integer", "null"], "minimum": 0 },
        "metadata": { "$ref": "#/$defs/json_object" }
      },
      "additionalProperties": false
    },
    "media_usage": {
      "type": "object",
      "required": ["usage_id", "document_id", "media_id", "usage_kind"],
      "properties": {
        "usage_id": { "type": "string" },
        "document_id": { "type": "string" },
        "media_id": { "type": "string" },
        "link_id": { "type": ["string", "null"] },
        "usage_kind": {
          "type": "string",
          "enum": ["embedded", "inferred_primary", "gallery", "linked_file", "generated_output", "unreferenced_inventory"]
        },
        "ordinal": { "type": "integer", "minimum": 0 },
        "line_number": { "type": ["integer", "null"], "minimum": 1 },
        "alt_text": { "type": ["string", "null"] },
        "caption": { "type": ["string", "null"] },
        "metadata": { "$ref": "#/$defs/json_object" }
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": ["entity_id", "entity_key", "entity_type", "canonical_name"],
      "properties": {
        "entity_id": { "type": "string" },
        "entity_key": { "type": "string" },
        "entity_type": { "type": "string" },
        "canonical_name": { "type": "string" },
        "display_name": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "summary": { "type": ["string", "null"] },
        "description_markdown": { "type": ["string", "null"] },
        "origin": { "type": ["string", "null"] },
        "metadata": { "$ref": "#/$defs/json_object" }
      },
      "additionalProperties": false
    },
    "entity_alias": {
      "type": "object",
      "required": ["alias_id", "entity_id", "alias"],
      "properties": {
        "alias_id": { "type": "string" },
        "entity_id": { "type": "string" },
        "alias": { "type": "string" },
        "normalized_alias": { "type": ["string", "null"] },
        "alias_type": { "type": ["string", "null"] },
        "source_name": { "type": ["string", "null"] },
        "metadata": { "$ref": "#/$defs/json_object" }
      },
      "additionalProperties": false
    },
    "entity_source": {
      "type": "object",
      "required": ["entity_source_id", "entity_id", "source_name"],
      "properties": {
        "entity_source_id": { "type": "string" },
        "entity_id": { "type": "string" },
        "document_id": { "type": ["string", "null"] },
        "source_name": { "type": "string" },
        "source_record_key": { "type": ["string", "null"] },
        "story_file": { "type": ["string", "null"] },
        "is_primary": { "type": "boolean" },
        "confidence": { "type": ["number", "null"] },
        "metadata": { "$ref": "#/$defs/json_object" }
      },
      "additionalProperties": false
    },
    "entity_relation": {
      "type": "object",
      "required": ["relation_id", "from_entity_id", "to_entity_id", "relation_type"],
      "properties": {
        "relation_id": { "type": "string" },
        "from_entity_id": { "type": "string" },
        "to_entity_id": { "type": "string" },
        "relation_type": { "type": "string" },
        "directionality": { "type": ["string", "null"], "enum": ["directed", "undirected", null] },
        "confidence": { "type": ["number", "null"] },
        "evidence_document_id": { "type": ["string", "null"] },
        "evidence_section_id": { "type": ["string", "null"] },
        "evidence_note": { "type": ["string", "null"] },
        "metadata": { "$ref": "#/$defs/json_object" }
      },
      "additionalProperties": false
    },
    "entity_prompt": {
      "type": "object",
      "required": ["prompt_id", "entity_id", "prompt_type", "prompt_text"],
      "properties": {
        "prompt_id": { "type": "string" },
        "entity_id": { "type": "string" },
        "prompt_type": { "type": "string" },
        "prompt_text": { "type": "string" },
        "source_name": { "type": ["string", "null"] },
        "source_record_key": { "type": ["string", "null"] },
        "story_file": { "type": ["string", "null"] },
        "is_current": { "type": "boolean" },
        "metadata": { "$ref": "#/$defs/json_object" }
      },
      "additionalProperties": false
    },
    "entity_media": {
      "type": "object",
      "required": ["entity_media_id", "entity_id", "media_id", "media_role"],
      "properties": {
        "entity_media_id": { "type": "string" },
        "entity_id": { "type": "string" },
        "media_id": { "type": "string" },
        "media_role": { "type": "string", "enum": ["primary", "gallery", "reference", "generated", "logo", "banner"] },
        "sort_order": { "type": "integer", "minimum": 0 },
        "source_name": { "type": ["string", "null"] },
        "metadata": { "$ref": "#/$defs/json_object" }
      },
      "additionalProperties": false
    },
    "media_generation": {
      "type": "object",
      "required": ["generation_id", "source_name", "status"],
      "properties": {
        "generation_id": { "type": "string" },
        "entity_id": { "type": ["string", "null"] },
        "media_id": { "type": ["string", "null"] },
        "source_name": { "type": "string" },
        "source_record_key": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "size": { "type": ["string", "null"] },
        "quality": { "type": ["string", "null"] },
        "status": { "type": "string" },
        "output_path": { "type": ["string", "null"] },
        "story_file": { "type": ["string", "null"] },
        "metadata": { "$ref": "#/$defs/json_object" }
      },
      "additionalProperties": false
    },
    "validation_issue": {
      "type": "object",
      "required": ["issue_id", "issue_type", "severity", "message"],
      "properties": {
        "issue_id": { "type": "string" },
        "document_id": { "type": ["string", "null"] },
        "section_id": { "type": ["string", "null"] },
        "entity_id": { "type": ["string", "null"] },
        "media_id": { "type": ["string", "null"] },
        "issue_type": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "metadata": { "$ref": "#/$defs/json_object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
